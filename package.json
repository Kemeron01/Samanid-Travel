{
  "name": "samanid-travel-frontend",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "pnpm --filter @samanid/ui storybook",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
